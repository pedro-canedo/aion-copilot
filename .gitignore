# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
packets_*.txt

node_modules
dist
dist-ssr
*.local

# Build artifacts
/src-tauri/target/
/src-tauri/gen/

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Local config
settings.properties

# Copied static files (generated from src/ at build/dev time)
/public/*
# The plugin windows' host page (src-tauri/src/plugins).
!/public/plugin-host.html
!/public/plugin-widget.html
!/public/src/
/public/src/*
!/public/src/js/
# aion-copilot: the bar's and the Painel's styles have no other source either
# (map.css and routine.css were added by hand; these two had been left out).
!/public/src/hub.css
!/public/src/painel.css
# ...and the images the UI loads (class icons, logo, support buttons). They have
# no other source in the repo, so without them a clean checkout (CI, the Arch
# package, a build from source) shows broken class icons.
!/public/assets/
!/public/src/assets/
# ...except vendored third-party libs, which are source, not generated. Without
# these a fresh clone builds an app whose icons 404.
!/public/vendor/
/assets/
/data/
/i18n/

# Debug binaries
/src-tauri/src/bin/
.claude/

# log service build output
/log-service/target/
/log-service/build/
/log-service/.dev.vars
/log-service/.wrangler/

# makepkg output (packaging/arch)
/packaging/arch/src/
/packaging/arch/pkg/
/packaging/arch/*.pkg.tar.zst

# Never commit a signing key.
*.pem

# aion-copilot: Npcap installer bundled for personal installs (Npcap free license), not versioned
src-tauri/deps/

# aion-copilot: the Routine overlay page and its stylesheet are source.
!/public/routine.html
!/public/src/routine.css
!/public/src/map.css
!/public/group.html
!/public/bosses.html
!/public/target.html
!/public/timers.html
!/public/map.html
!/public/pets.html
!/public/hub.html
!/public/painel.html

# aion-copilot: reverse-engineering notes and tools stay local, off the public repo
/docs/re/
/tools/re/
